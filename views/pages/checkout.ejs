<!DOCTYPE html>
<html lang="en">
	<head>
		<!-- COMMON HEAD ELEMENTS -->
<%- include('../partials/head.ejs') %>
		<!-- END COMMON HEAD ELEMENTS -->
		
		<title>PCOM Library <%= campus_short %> Self-Checkout</title>
	</head>
	<body>

		<!-- COMMON HEADER -->
<%- include('../partials/header') %>
		<!-- END COMMON HEADER -->

		<main>

			<form id="checkout_form" autocomplete="off" method="post"
			 action="/confirm">

				<fieldset class="active-step" id="step1">
					<legend>1. User your PCOM ID to enter your patron barcode.</legend>
					<div class="step">
						<div class="step-input">
							<label>
								<span>Patron Barcode:</span>
								<input id="patron_barcode" name="patron_barcode" type="text" aria-describedby="id-instructions" autofocus>
							</label>
						</div>
						<div class="step-instruction">
							<p id="id-instructions">
								Place your PCOM ID near the WaveID Reader. The red LED will change to green and you will hear a beep.
							</p>
							<div class="photo-group">
								<img src="card-reader-example.png" alt="Showing how the WaveID card reader changes from a red LED light to a green LED light when a PCOM ID card is brought near it.">
							</div>
						</div>
					</div>
					<div class="form-nav">
						<div class="button-bar">
							<button type="button" id="to-book">Next</button>
						</div>
					</div>
				</fieldset>

				<fieldset id="step2">
					<legend>2. Scan the book's barcode on the front cover. </legend>
					<div class="step">
						<div class="step-input">
							<label>
								<span>Book Barcode:</span>
								<input id="book_barcode" name="book_barcode" type="text" aria-describedby="book-instructions">
							</label>
						</div>
						<div class="step-instruction">
							<p id="book-instructions">
								Hold down the yellow button on the scanner and place the barcode on the FRONT OF THE BOOK under the red scan line.
							</p>
							<div class="photo-group">
								<img src="book-scanner.png" alt="The barcode scanner in its stand. The yellow button is visible on the top of the scanner.">
								<img src="book-barcode.png" alt="Front cover a book with a barcode sticker in the upper left corner. A red scan line is over the barcode.">
							</div>
						</div>
					</div>
					<div class="form-nav">
						<div class="button-bar">
							<button type="button" id="back-to-id">Previous</button>
							<button type="submit" id="to-checkout" form="checkout_form">Next</button>
						</div>
					</div>					
				</fieldset>
			</form>
		</main>
		
		<!-- COMMON FOOTER -->
<%- include('../partials/footer') %>
		<!-- END COMMON FOOTER -->
	
	</body>
</html>