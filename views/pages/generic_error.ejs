<!DOCTYPE html>
<html lang="en">
	<head>
<%- include('../partials/head') %>
		<title>Generic Error: PCOM Library Self-Checkout</title>
	</head>
	<body class="error">
	
		<!-- COMMON HEADER -->
<%- include('../partials/header') %>
		<!-- END COMMON HEADER -->

		<main>
			<div id="content">
				<h2>
					<span class="fa-solid fa-triangle-exclamation"></span>
					<%- heading %>
					<span class="fa-solid fa-triangle-exclamation"></span>
				</h2>
				<div class="error_message">
					<p><%- message %></p>
					<% if(typeof exception_error != 'undefined') { %>
					<div class="debug">
						<h3>Debugging information:</h3>
						<p><%= exception_error %></p>
					</div>
					<% } %>
				</div>
			</div>

<%- include('../partials/page_reset_html') %>

		</main>

		<!-- COMMON FOOTER -->
<%- include('../partials/footer') %>
		<!-- END COMMON FOOTER -->

<%- include('../partials/page_reset_script') %>
		</script>
	</body>
</html>